# Configuración general
client      = "pragma"
project     = "api"
environment = "dev"

# Configuración de servicios ECS
ecs_services = {
  "api" = {
    # Configuración básica del servicio
    cluster_name               = "pragma-api-dev-cluster"
    desired_count              = 2
    deployment_maximum_percent = 200
    deployment_minimum_percent = 100
    enable_execute_command     = true
    force_new_deployment       = false
    health_check_grace_period  = 60
    launch_type                = "FARGATE"
    platform_version           = "LATEST"
    scheduling_strategy        = "REPLICA"

    # Configuración de red
    assign_public_ip = false
    subnets          = ["subnet-0abc123def456789a", "subnet-0bcd234efa5678901"]
    security_groups  = ["sg-0abc123def456789a"]

    # Configuración de definición de tarea
    task_cpu                 = 1024
    task_memory              = 2048
    requires_compatibilities = ["FARGATE"]
    execution_role_arn       = "arn:aws:iam::123456789012:role/pragma-api-dev-ecs-execution-role"
    task_role_arn            = "arn:aws:iam::123456789012:role/pragma-api-dev-ecs-task-role"

    # Configuración de contenedores
    containers = {
      # Contenedor principal de la aplicación
      "app" = {
        # Configuración básica del contenedor
        image                    = "123456789012.dkr.ecr.us-east-1.amazonaws.com/pragma-api:latest"
        cpu                      = 512
        memory                   = 1024
        essential                = true
        readonly_root_filesystem = false
        
        # Configuración de comandos y entorno
        command                  = ["/bin/sh", "-c", "npm start"]
        environment = [
          {
            name  = "NODE_ENV"
            value = "development"
          },
          {
            name  = "PORT"
            value = "8080"
          },
          {
            name  = "LOG_LEVEL"
            value = "info"
          },
          # Variables de entorno para APM de Datadog
          {
            name  = "DD_AGENT_HOST"
            value = "localhost"
          },
          {
            name  = "DD_TRACE_AGENT_PORT"
            value = "8126"
          },
          {
            name  = "DD_SERVICE"
            value = "api"
          },
          {
            name  = "DD_ENV"
            value = "development"
          },
          {
            name  = "DD_VERSION"
            value = "1.0.0"
          }
        ]
        
        # Configuración de secretos
        secrets = [
          {
            name       = "DATABASE_URL"
            value_from = "arn:aws:ssm:us-east-1:123456789012:parameter/pragma/api/dev/database-url"
          },
          {
            name       = "API_KEY"
            value_from = "arn:aws:secretsmanager:us-east-1:123456789012:secret:pragma/api/dev/api-key:key::"
          }
        ]
        
        # Configuración de puertos
        port_mappings = [
          {
            container_port = 8080
            host_port      = 8080
            protocol       = "tcp"
          }
        ]
        
        # Configuración de healthcheck
        healthcheck = {
          command     = ["CMD-SHELL", "curl -f http://localhost:8080/health || exit 1"]
          interval    = 30
          timeout     = 5
          retries     = 3
          start_period = 60
        }
        
        # Configuración de logs para enviar a Datadog a través de FireLens
        log_configuration = {
          log_driver = "awsfirelens"
          options = {
            "Name"       = "datadog"
            "Host"       = "http-intake.logs.datadoghq.com"
            "TLS"        = "on"
            "dd_service" = "api"
            "dd_source"  = "nodejs"
            "dd_tags"    = "env:dev,project:api"
            "provider"   = "ecs"
          }
          secret_options = [
            {
              name       = "apikey"
              value_from = "arn:aws:secretsmanager:us-east-1:123456789012:secret:datadog/api-key:SecretString:apikey"
            }
          ]
        }
        
        # Dependencia del contenedor log_router
        depends_on = [
          {
            container_name = "log_router"
            condition      = "START"
          }
        ]
      },
      
      # Contenedor FireLens para enrutamiento de logs
      "log_router" = {
        image = "public.ecr.aws/aws-observability/aws-for-fluent-bit:stable"
        essential = true
        cpu = 128
        memory = 256
        user = "0"
        
        # Configuración de logs para el propio router
        log_configuration = {
          log_driver = "awslogs"
          options = {
            "awslogs-group"        = "/aws/ecs/pragma-api-dev"
            "awslogs-create-group" = "true"
            "awslogs-region"       = "us-east-1"
            "awslogs-stream-prefix" = "firelens"
          }
        }
        
        # Configuración de FireLens
        firelens_configuration = {
          type = "fluentbit"
          options = {
            "enable-ecs-log-metadata" = "true"
          }
        }
      },
      
      # Contenedor del agente Datadog
      "datadog-agent" = {
        image = "public.ecr.aws/datadog/agent:latest"
        cpu   = 256
        memory = 512
        essential = false
        
        # Variables de entorno para el agente Datadog
        environment = [
          {
            name  = "DD_SITE"
            value = "datadoghq.com"
          },
          {
            name  = "DD_ECS_COLLECT_RESOURCE_TAGS_EC2"
            value = "true"
          },
          {
            name  = "DD_APM_ENABLED"
            value = "true"
          },
          {
            name  = "DD_APM_NON_LOCAL_TRAFFIC"
            value = "true"
          },
          {
            name  = "DD_LOGS_ENABLED"
            value = "true"
          },
          {
            name  = "DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL"
            value = "true"
          },
          {
            name  = "DD_CONTAINER_EXCLUDE"
            value = "name:datadog-agent"
          },
          {
            name  = "DD_PROCESS_AGENT_ENABLED"
            value = "true"
          },
          {
            name  = "DD_DOGSTATSD_NON_LOCAL_TRAFFIC"
            value = "true"
          }
        ]
        
        # Secretos para el agente Datadog
        secrets = [
          {
            name       = "DD_API_KEY"
            value_from = "arn:aws:secretsmanager:us-east-1:123456789012:secret:datadog/api-key:SecretString:apikey"
          }
        ]
        
        # Configuración de puertos para el agente
        port_mappings = [
          {
            container_port = 8126
            host_port      = 8126
            protocol       = "tcp"
          },
          {
            container_port = 8125
            host_port      = 8125
            protocol       = "udp"
          }
        ]
        
        # Configuración de logs para el agente
        log_configuration = {
          log_driver = "awslogs"
          options = {
            "awslogs-group"        = "/aws/ecs/pragma-api-dev"
            "awslogs-create-group" = "true"
            "awslogs-region"       = "us-east-1"
            "awslogs-stream-prefix" = "datadog-agent"
          }
        }
      }
    }
    
    # Configuración de balanceador de carga
    load_balancer = {
      target_group_arn = "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/pragma-api-dev/abcdef1234567890"
      container_name   = "app"
      container_port   = 8080
    }
    
    # Configuración de Auto Scaling
    enable_autoscaling = true
    autoscaling_config = {
      min_capacity = 2
      max_capacity = 10
      scaling_policies = [
        {
          name        = "cpu-tracking"
          policy_type = "TargetTrackingScaling"
          target_tracking_configuration = {
            target_value       = 70.0
            scale_in_cooldown  = 300
            scale_out_cooldown = 300
            predefined_metric_type = "ECSServiceAverageCPUUtilization"
          }
        },
        {
          name        = "memory-tracking"
          policy_type = "TargetTrackingScaling"
          target_tracking_configuration = {
            target_value       = 80.0
            scale_in_cooldown  = 300
            scale_out_cooldown = 300
            predefined_metric_type = "ECSServiceAverageMemoryUtilization"
          }
        }
      ]
    }
    
    # Configuración de logs
    log_retention_days     = 30
    log_encryption_key_arn = "arn:aws:kms:us-east-1:123456789012:key/1234abcd-12ab-34cd-56ef-1234567890ab"
    
    # Etiquetas adicionales
    additional_tags = {
      "service-tier"       = "critical"
      "backup-policy"      = "daily"
      "data-classification" = "internal"
      "cost-center"        = "tech-dept"
      "monitoring"         = "datadog"
    }
  }
}
